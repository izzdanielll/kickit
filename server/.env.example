NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://kickit:replace-me@localhost:5432/kickit?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
AUDIT_LOG_SECRET=replace-with-a-different-32-character-secret
JWT_EXPIRES_IN=15m
JWT_COOKIE_MAX_AGE_MS=900000
CLIENT_URL=http://localhost:3000
TRUST_PROXY_HOPS=0
REDIS_URL=redis://localhost:6379
SPORTS_API_URL=https://sports-provider.example/v1/player-gameweek-stats
SPORTS_API_KEY=replace-me
SPORTS_MIN_COVERAGE_PERCENT=95
REQUIRE_EMAIL_VERIFICATION=false
RESEND_API_KEY=
EMAIL_FROM=KickIt <no-reply@example.com>
EMAIL_VERIFICATION_TTL_MS=86400000
PASSWORD_RESET_TTL_MS=3600000
ACCOUNT_REQUEST_MIN_DELAY_MS=750
MAX_ACTIVE_SESSIONS_PER_USER=10
METRICS_TOKEN=replace-with-an-observability-token-of-at-least-32-characters
ACCOUNT_TOKEN_RETENTION_DAYS=7
SECURITY_EVENT_RETENTION_DAYS=90
