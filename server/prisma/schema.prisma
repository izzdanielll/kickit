// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

enum Position {
  GK
  DEF
  MID
  FWD
}

enum PackType {
  BRONZE
  SILVER
  GOLD
  PROMO
}

enum MatchResult {
  WIN
  LOSS
  DRAW
}

enum Currency {
  COINS
  GEMS
}

enum ListingStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// ─── Users ──────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  coins        Int      @default(500)
  gems         Int      @default(0)
  xp           Int      @default(0)
  level        Int      @default(1)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cards          Card[]
  squads         Squad[]
  matchesHome    Match[]              @relation("HomeUser")
  matchesAway    Match[]              @relation("AwayUser")
  packOpenings   PackOpening[]
  listingsSold   MarketplaceListing[] @relation("ListingSeller")
  listingsBought MarketplaceListing[] @relation("ListingBuyer")

  @@map("users")
}

// ─── Cards ──────────────────────────────────────────────

model CardTemplate {
  id           String   @id @default(uuid())
  playerName   String
  club         String
  league       String
  nationality  String
  position     Position
  rarity       Rarity
  baseAttack   Int
  baseDefense  Int
  basePace     Int
  basePassing  Int
  basePhysical Int
  specialTrait String?
  imageUrl     String?
  season       String   @default("2024-25")
  createdAt    DateTime @default(now())

  cards Card[]

  @@unique([playerName, season])
  @@map("card_templates")
}

model Card {
  id            String       @id @default(uuid())
  owner         User         @relation(fields: [ownerId], references: [id])
  ownerId       String
  template      CardTemplate @relation(fields: [templateId], references: [id])
  templateId    String
  level         Int          @default(1)
  xp            Int          @default(0)
  bonusAttack   Int          @default(0)
  bonusDefense  Int          @default(0)
  bonusPace     Int          @default(0)
  bonusPassing  Int          @default(0)
  bonusPhysical Int          @default(0)
  isLocked      Boolean      @default(false)
  acquiredAt    DateTime     @default(now())
  packOpening   PackOpening? @relation(fields: [packOpeningId], references: [id])
  packOpeningId String?

  squadCards SquadCard[]
  listings   MarketplaceListing[]

  @@map("cards")
  @@index([ownerId, acquiredAt])
  @@index([templateId])
}

// ─── Squads ─────────────────────────────────────────────

model Squad {
  id        String   @id @default(uuid())
  name      String
  owner     User     @relation(fields: [ownerId], references: [id])
  ownerId   String
  formation String   @default("1-2-1")
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  squadCards  SquadCard[]
  matchesHome Match[]     @relation("HomeSquad")
  matchesAway Match[]     @relation("AwaySquad")

  @@map("squads")
  @@index([ownerId, isActive])
}

model PackDefinition {
  id        String   @id @default(uuid())
  type      PackType @unique
  name      String
  coinCost  Int?
  gemCost   Int?
  cardCount Int      @default(5)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  openings PackOpening[]

  @@map("pack_definitions")
}

model PackOpening {
  id       String         @id @default(uuid())
  owner    User           @relation(fields: [ownerId], references: [id])
  ownerId  String
  pack     PackDefinition @relation(fields: [packId], references: [id])
  packId   String
  currency Currency
  cost     Int
  openedAt DateTime       @default(now())

  cards Card[]

  @@index([ownerId, openedAt])
  @@map("pack_openings")
}

model MarketplaceListing {
  id        String        @id @default(uuid())
  card      Card          @relation(fields: [cardId], references: [id])
  cardId    String
  seller    User          @relation("ListingSeller", fields: [sellerId], references: [id])
  sellerId  String
  buyer     User?         @relation("ListingBuyer", fields: [buyerId], references: [id])
  buyerId   String?
  price     Int
  currency  Currency
  status    ListingStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([sellerId, status])
  @@map("marketplace_listings")
}

model SquadCard {
  id        String @id @default(uuid())
  squad     Squad  @relation(fields: [squadId], references: [id], onDelete: Cascade)
  squadId   String
  card      Card   @relation(fields: [cardId], references: [id])
  cardId    String
  slotIndex Int

  @@unique([squadId, slotIndex])
  @@unique([squadId, cardId])
  @@map("squad_cards")
}

// ─── Matches ────────────────────────────────────────────

model Match {
  id          String       @id @default(uuid())
  homeUser    User         @relation("HomeUser", fields: [homeUserId], references: [id])
  homeUserId  String
  awayUser    User         @relation("AwayUser", fields: [awayUserId], references: [id])
  awayUserId  String
  homeSquad   Squad        @relation("HomeSquad", fields: [homeSquadId], references: [id])
  homeSquadId String
  awaySquad   Squad        @relation("AwaySquad", fields: [awaySquadId], references: [id])
  awaySquadId String
  homeScore   Int          @default(0)
  awayScore   Int          @default(0)
  result      MatchResult?
  coinsEarned Int          @default(0)
  xpEarned    Int          @default(0)
  matchLog    Json?
  playedAt    DateTime     @default(now())

  @@map("matches")
  @@index([homeUserId, playedAt])
  @@index([awayUserId, playedAt])
}
