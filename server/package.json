{
  "name": "kickit-server",
  "version": "0.1.0",
  "description": "kickIt Backend API — NestJS",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "test": "ts-node test/scoring.test.ts && ts-node test/packs.test.ts && ts-node test/sports-data.test.ts && ts-node test/gameweek-settlement.test.ts && ts-node test/leaderboard-cache.test.ts && ts-node test/transaction-retry.test.ts && ts-node test/pagination.test.ts && ts-node test/auth-input.test.ts && ts-node test/session-security.test.ts && ts-node test/account-recovery.test.ts && ts-node test/marketplace-security.test.ts && ts-node test/observability.test.ts && ts-node test/security-retention.test.ts && ts-node test/security-audit.test.ts && ts-node test/environment-validation.test.ts && node test/release-gate.test.js",
    "test:e2e": "ts-node test/http-e2e.test.ts",
    "load:smoke": "node scripts/load-smoke.js",
    "load:authenticated": "node scripts/authenticated-load.js",
    "backup:snapshot": "node scripts/database-snapshot.js",
    "restore:verify": "node scripts/verify-restore.js && node scripts/reconcile-economy.js",
    "release:verify": "node scripts/release-gate.js",
    "economy:reconcile": "node scripts/reconcile-economy.js",
    "security:static": "node scripts/static-security-check.js",
    "test:staging": "node scripts/staging-acceptance.js",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy && prisma db seed",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^5.22.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
